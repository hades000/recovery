<mxfile host="app.diagrams.net" modified="2026-10-27T00:00:00.000Z" agent="scbx-aisdlc-playbook" version="24.7.8" type="device"><diagram id="stage-run" name="How one stage runs"><mxGraphModel dx="1140" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="How one stage runs with the toolkit (the same pattern for Specify, Plan, Implement and the testing stages). Click a step." style="text;html=1;fontSize=13;fontStyle=1;align=left;fontColor=#263238;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1100" height="24" as="geometry"/></mxCell><mxCell id="l_squad" value="Squad" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#f0f3f5;strokeColor=#90a4ae;fontColor=#263238;fontSize=12;fontStyle=1;startSize=34;" vertex="1" parent="1"><mxGeometry x="30" y="56" width="1080" height="120" as="geometry"/></mxCell><mxCell id="l_agent" value="Agent" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#f0f3f5;strokeColor=#90a4ae;fontColor=#263238;fontSize=12;fontStyle=1;startSize=34;" vertex="1" parent="1"><mxGeometry x="30" y="176" width="1080" height="150" as="geometry"/></mxCell><mxCell id="l_toolkit" value="Toolkit files" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#f0f3f5;strokeColor=#90a4ae;fontColor=#263238;fontSize=12;fontStyle=1;startSize=34;" vertex="1" parent="1"><mxGeometry x="30" y="326" width="1080" height="110" as="geometry"/></mxCell><mxCell id="l_gate" value="Gate" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;fillColor=#f0f3f5;strokeColor=#90a4ae;fontColor=#263238;fontSize=12;fontStyle=1;startSize=34;" vertex="1" parent="1"><mxGeometry x="30" y="436" width="1080" height="110" as="geometry"/></mxCell><UserObject label="1 · New chat. Start the stage agent with RUN_ID and the approved inputs of the previous stage" link="/getting-started/overview#working-rules" id="q1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4e2a84;fontColor=#263238;fontSize=11;" vertex="1" parent="l_squad"><mxGeometry x="50" y="30" width="220" height="66" as="geometry"/></mxCell></UserObject><UserObject label="5 · Review the output against the stage checklist" link="/getting-started/overview#the-stages" id="q5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4e2a84;fontColor=#263238;fontSize=11;" vertex="1" parent="l_squad"><mxGeometry x="560" y="30" width="200" height="66" as="geometry"/></mxCell></UserObject><UserObject label="7 · Approve, then start the next stage manually (NEXT_STEP)" link="/getting-started/overview#working-rules" id="q7"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4e2a84;fontColor=#263238;fontSize=11;" vertex="1" parent="l_squad"><mxGeometry x="830" y="30" width="200" height="66" as="geometry"/></mxCell></UserObject><UserObject label="2 · Read .github/contexts, rules, templates and the increment card" link="/agents/context-builder" id="g2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4e2a84;fontColor=#263238;fontSize=11;" vertex="1" parent="l_agent"><mxGeometry x="50" y="20" width="220" height="56" as="geometry"/></mxCell></UserObject><UserObject label="3 · Produce the artefact under output/RUN_ID/ with trace IDs (SPEC-*, TASK-*, CODE-*, APT-*, FT-*)" link="/toolkit#standard-repository-structure" id="g3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4e2a84;fontColor=#263238;fontSize=11;" vertex="1" parent="l_agent"><mxGeometry x="300" y="20" width="230" height="56" as="geometry"/></mxCell></UserObject><UserObject label="4 · Invoke Compliance Reviewer at the spec, plan and code gates; then stop and report NEXT_STEP" link="/agents/supporting-agents#compliance-reviewer" id="g4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4e2a84;fontColor=#263238;fontSize=11;" vertex="1" parent="l_agent"><mxGeometry x="560" y="20" width="240" height="56" as="geometry"/></mxCell></UserObject><UserObject label="BLOCKED when inputs are missing or findings are unresolved; never improvise endpoints, screens or assumptions" link="/agents/spec-clarify#limitations-and-stop-conditions" id="gblk"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#d98e04;fontColor=#263238;fontSize=10;" vertex="1" parent="l_agent"><mxGeometry x="300" y="86" width="500" height="44" as="geometry"/></mxCell></UserObject><UserObject label=".github/agents/*.agent.md" link="/toolkit#agents" id="f1"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece4f6;strokeColor=#4e2a84;fontColor=#263238;fontSize=10;" vertex="1" parent="l_toolkit"><mxGeometry x="50" y="30" width="176" height="56" as="geometry"/></mxCell></UserObject><UserObject label=".github/rules/ · .github/templates/" link="/toolkit#rules" id="f2"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece4f6;strokeColor=#4e2a84;fontColor=#263238;fontSize=10;" vertex="1" parent="l_toolkit"><mxGeometry x="250" y="30" width="176" height="56" as="geometry"/></mxCell></UserObject><UserObject label=".github/contexts/ (Context Builder)" link="/agents/context-builder" id="f3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece4f6;strokeColor=#4e2a84;fontColor=#263238;fontSize=10;" vertex="1" parent="l_toolkit"><mxGeometry x="450" y="30" width="176" height="56" as="geometry"/></mxCell></UserObject><UserObject label="output/RUN_ID/ · requirement/Traceability_Matrix.md" link="/toolkit#standard-repository-structure" id="f4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece4f6;strokeColor=#4e2a84;fontColor=#263238;fontSize=10;" vertex="1" parent="l_toolkit"><mxGeometry x="650" y="30" width="176" height="56" as="geometry"/></mxCell></UserObject><UserObject label=".vscode/mcp.json: Playwright, Jira, Confluence, GitLab" link="/toolkit#mcp-servers" id="f5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ece4f6;strokeColor=#4e2a84;fontColor=#263238;fontSize=10;" vertex="1" parent="l_toolkit"><mxGeometry x="850" y="30" width="176" height="56" as="geometry"/></mxCell></UserObject><UserObject label="6 · Human approval gate: PO (spec), FDA (plan, quality), FDE (tasks, code review, release), PO/PM (deploy)" link="/overview/end-to-end-flow#human-approval-gates" id="k6"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#d98e04;fontColor=#263238;fontSize=11;" vertex="1" parent="l_gate"><mxGeometry x="560" y="24" width="300" height="62" as="geometry"/></mxCell></UserObject><UserObject label="Critical / High / Medium findings block until remediated or explicitly accepted. Low-only FAIL → REVIEW_GATE_WARNING, human disposition" link="/agents/supporting-agents#compliance-reviewer" id="ksev"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d98e04;fontColor=#263238;fontSize=10;" vertex="1" parent="l_gate"><mxGeometry x="50" y="24" width="480" height="62" as="geometry"/></mxCell></UserObject><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;html=1;strokeColor=#546e7a;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="q1" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;html=1;strokeColor=#546e7a;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;html=1;strokeColor=#546e7a;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;html=1;strokeColor=#546e7a;strokeWidth=1.5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="g4" target="q5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;html=1;strokeColor=#546e7a;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="q5" target="k6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="119"/><mxPoint x="870" y="446"/></Array></mxGeometry></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;html=1;strokeColor=#546e7a;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="k6" target="q7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1092" y="491"/><mxPoint x="1092" y="119"/></Array></mxGeometry></mxCell><UserObject label="Every stage is human-initiated. Stage agents are never chained automatically; a workflow prompt pauses after every step and continues only on explicit instruction." link="/agents/supporting-agents#workflow-prompts" id="v8"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3e6;strokeColor=#2e7d32;fontColor=#263238;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="1080" height="30" as="geometry"/></mxCell></UserObject></root></mxGraphModel></diagram></mxfile>