{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chromium",
        "--isolated",
        "--viewport-size",
        "1280x720",
        "--test-id-attribute",
        "data-testid",
        "--output-dir",
        "generated_tests/_mcp-artifacts",
        "--save-session",
        "--allowed-origins",
        "http://localhost:5173;http://127.0.0.1:5173;http://localhost:8080;http://127.0.0.1:8080"
      ]
    },
    "jira": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${AISDLC_TOOLKIT}/mcp/jira/dist/index.js"
      ]
    },
    "confluence": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${AISDLC_TOOLKIT}/mcp/confluence/dist/index.js"
      ]
    },
    "gitlab": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${AISDLC_TOOLKIT}/mcp/gitlab/dist/index.js"
      ]
    }
  }
}
