        "SPEC-RWB-TE-001-010",
        "SPEC-RWB-TE-001-012"
      ],
      "rules": [
        {
          "code": "MAP",
          "engine": "ArchUnit",
          "checks": [
            "every package directly under rootPackage holding a class, directly or in a sub-package, is a map module",
            "every map module package exists",
            "root package holds only package-info",
            "@NamedInterface packages equal the map's existing published packages",
            "no public type directly in a module base package (D-RCV-42)",
            "no type-level @NamedInterface under rootPackage (D-RCV-42)"
          ],
          "failureText": "package {package} is not in the module map (and SPEC-004 texts)"
        },
        {
          "code": "BND-1",
          "engine": "ArchUnit",
          "allowEmptyShould": true,
          "subject": "classes under rootPackage",
          "forbidden": "classes under external.collection.rootPackage outside its published packages"
        },
        {
          "code": "BND-2",
          "engine": "ArchUnit",
          "allowEmptyShould": true,
          "subject": "classes under rootPackage",
          "forbidden": "classes under external.common.rootPackage outside its published packages"
        },
        {
          "code": "BND-3",
          "engine": "Spring Modulith verify() via existing ModulithTest",
          "decision": "CLAR-005 A; D-RCV-42",
          "failureText": "Spring Modulith's own text (accepted deviation from story §14)",
          "notes": "verify() also fails on cycles between recovery modules (accepted, D-RCV-11); event types are type dependencies"
        },
        {
          "code": "BND-4",
          "engine": "ArchUnit",
          "entity": "@jakarta.persistence.Entity",
          "repository": "subtype of org.springframework.data.repository.Repository",
          "subject": "classes under rootPackage",
          "allowed": "entities and repositories of the same recovery module only",
          "decision": "CLAR-001 A"
        },
        {
          "code": "BND-5",
          "engine": "ArchUnit",
          "subject": "classes under rootPackage",
          "forbidden": "classes matching a clientLibraries entry on a name boundary (see schema.clientLibraries.meaning)",
          "allowedIn": "a module's clientPackages (and sub-packages)",
          "decision": "CLAR-006 B"
        }
      ],
      "failureTextTemplate": "Rule {code} broken: {class} depends on {dependency}. Use {module}.api or an application event.",
      "personalData": "none; class and package names only"
    }
