      "id": "CON-RWB-TE-001-002",
      "kind": "boundary-rule-set",
      "frontendConsumer": "NONE (backend-only, build time)",
      "runIn": "ACE Gradle task test (untagged JUnit 5); CI check target: npx nx affected -t check on merge requests, npx nx run-many -t check on the default branch; no CI file change (D-RCV-05)",
      "classImport": "main classes only (ArchUnit do-not-include-tests)",
      "specRefs": [
        "SPEC-RWB-TE-001-004",
        "SPEC-RWB-TE-001-005",
        "SPEC-RWB-TE-001-006",
