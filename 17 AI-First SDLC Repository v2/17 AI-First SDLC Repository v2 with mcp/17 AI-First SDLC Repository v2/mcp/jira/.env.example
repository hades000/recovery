# Jira connection. Copy to .env (same folder) and fill in, OR pass these via your MCP client config.
JIRA_URL=https://your-company.atlassian.net

# Jira Cloud: Atlassian account email + API token (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_EMAIL=you@your-company.com
JIRA_API_TOKEN=

# Jira Server / Data Center: Personal Access Token (Profile > Personal Access Tokens). Leave JIRA_EMAIL empty.
# JIRA_PAT=

# Optional: force "cloud" or "server" (auto-detected from *.atlassian.net otherwise)
# JIRA_DEPLOYMENT=cloud
