    {
      "id": "hdr_why",
      "type": "text",
      "x": 60,
      "y": 124,
      "width": 1709,
      "height": 23,
      "angle": 0,
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
