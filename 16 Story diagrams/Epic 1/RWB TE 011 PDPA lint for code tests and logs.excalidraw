      "roundness": null,
      "seed": 69005,
      "version": 1,
      "versionNonce": 569005,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Why: PDPA leaks usually start in a log line or a test fixture. The rules are generated from the data dictionary, and the lint never prints the value it found.",
      "originalText": "Why: PDPA leaks usually start in a log line or a test fixture. The rules are generated from the data dictionary, and the lint never prints the value it found.",
      "fontSize": 18,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
