      "versionNonce": 561005,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Why: 19 modules stay separable. The build fails the moment a class imports another module's internals; E1-069 adds BND-6 so nobody reads public.* tables.",
      "originalText": "Why: 19 modules stay separable. The build fails the moment a class imports another module's internals; E1-069 adds BND-6 so nobody reads public.* tables.",
