      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Why: No agent talks to a model directly. Inputs are masked, outputs are checked, every run is recorded with cost, and Risk approves each prompt and policy.",
