      "versionNonce": 564005,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Why: Testers need production-sized data with real balances and dates, but PDPA forbids real names and IDs. Any personal-looking value refuses the whole load.",
