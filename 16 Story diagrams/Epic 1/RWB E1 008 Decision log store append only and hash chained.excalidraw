      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Why: Audit and Compliance must trust the decision log. Each entry hashes the previous one, and the database refuses UPDATE and DELETE.",
