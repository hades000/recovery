  "path": [
    {
      "kind": "trigger",
      "text": "EV-01 CaseCreated"
    },
    {
      "kind": "function",
      "text": "5 tools read case, docs, contacts"
    },
    {
      "kind": "ace",
      "text": "v_ace_contact + v_ace_valuation"
    },
    {
      "kind": "ai",
      "text": "INTAKE agent in SHADOW"
    },
    {
      "kind": "table",
      "text": "agent_run (no case change)"
    },
    {
      "kind": "out",
      "text": "Scored on INTAKE-S1"
    }
  ],
  "rules": [
    "BR1: shadow output is never shown and changes nothing",
    "BR2: one run per case per business date",
    "BR4: a stale ACE input must produce the STALE_INPUT gap",
    "BR5: agreement = matches / labelled cases"
  ],
  "risks": [
    "Timeout or guardrail failure -> stored as a failure, no retry",
    "ACE batch not COMPLETE and no STALE_INPUT gap -> SCHEMA_RULE fails",
    "Empty evaluation sample -> 422 (MSG-P10-002)"
  ],
  "example": [
    "200 cases created 2026-11-30 to 2026-12-04 -> 200 SHADOW runs",
    "No case, task or decision-log change",
    "Gap types: MISSING_DOCUMENT, NO_VALID_APPRAISAL, NO_CONTACT_POINT, STALE_INPUT"
  ]
