  "needs": [
    "E1-066",
    "E1-037",
    "E1-016"
  ],
  "unblocks": [
    "E1-023",
    "E1-062"
  ],
  "triggers": [
    [
      "API",
      "GET /cases/{caseId}/interactions?channel=&actor="
    ],
    [
      "WHO",
      "Case owner, team manager, conduct, audit"
    ],
    [
      "CALL",
      "InteractionLedgerReader (published)"
    ]
  ],
  "ace": [],
  "ace_note": "No ACE read. EFS history from v_ace_efs_action is merged in by the case record view (E1-023).",
  "writes": [],
  "reads": [
    {
      "t": "interaction",
      "note": "ordered by occurred_at, case_seq"
    },
    {
      "t": "recovery_case.id",
      "note": "scope via CaseScopeQuery"
    }
  ],
  "stores": "PII access log for any unmasked read; P4 MaskingPolicy",
  "functions": [
    {
      "name": "InteractionLedgerReader",
      "does": "the one read path (published)"
    },
    {
      "name": "LedgerReadService",
      "does": "scope, filter, query, mask, log"
    },
    {
      "name": "InteractionRepository",
      "does": "filtered, ordered query"
    },
    {
      "name": "InteractionsHandler (P3)",
      "does": "API-P3-014 + actor filter"
    },
    {
      "name": "CaseHistoryPanel",
      "does": "React SCR-03 history panel"
    }
  ],
  "path": [
    {
      "kind": "trigger",
      "text": "Open SCR-03 history"
    },
    {
      "kind": "check",
      "text": "Scope + filter valid?"
    },
    {
      "kind": "table",
      "text": "interaction ordered by time"
    },
    {
      "kind": "function",
      "text": "Mask summary by role"
    },
    {
      "kind": "store",
      "text": "PII log for unmasked fields"
    },
    {
      "kind": "out",
      "text": "InteractionPage on SCR-03"
