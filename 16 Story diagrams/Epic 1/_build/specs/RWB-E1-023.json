{
  "key": "RWB-E1-023",
  "file_stem": "RWB E1 023 Case record view v1 read only",
  "title": "Case record view v1, read only",
  "module": "P3 Case and workflow",
  "flag": "rwb.p3.caserecordview",
  "status": "PARTIAL",
  "status_text": "Ready. Stale banner waits for RWB-ACE-001",
  "theme": "default",
  "overview_label": "Case record view (SCR-03)",
  "goal": "One read-only case screen: live ACE data by key, dated sections, masked and logged personal data",
  "why": "Case owners stop switching between ALS, EFS and spreadsheets. Nothing is copied: the screen reads 4 views live and shows how old each section is.",
  "needs": [
    "E1-018",
    "E1-024",
    "E1-037",
    "E1-039",
    "E1-068",
    "E1-069"
  ],
  "unblocks": [
    "E1-035"
  ],
  "triggers": [
    [
      "WHO",
      "Case owner opens a case from SCR-02"
    ],
    [
      "API",
      "GET /cases/{caseId} (+ accounts, parties)"
    ],
    [
      "API",
      "GET /cases/{caseId}/interactions, /documents"
    ],
    [
      "EVENT",
      "AC-READ access event per read"
    ]
  ],
  "ace": [
    {
      "view": "v_ace_account",
      "section": "A",
      "note": "account_code, days_past_due, total_balance, data_as_of"
    },
    {
      "view": "v_ace_customer",
      "section": "A",
      "note": "cif_no, names, id_no_masked, id_no_last4"
    },
    {
      "view": "v_ace_contact",
      "section": "A",
      "note": "contact_value + contact_value_masked by contact_key"
    },
    {
      "view": "v_ace_efs_action",
      "section": "A",
      "note": "EFS contact history: action_code, contact_at, comments"
    },
    {
      "view": "v_ace_batch_status",
      "section": "B",
      "note": "stale banner if the batch is not COMPLETE"
    }
  ],
  "ace_note": "",
  "writes": [],
  "reads": [
    {
      "t": "recovery_case",
      "note": "header: case_no, status, owner"
    },
    {
      "t": "case_account, case_party",
      "note": "business keys to look up in ACE"
    },
    {
      "t": "queue",
      "note": "queue and team names"
    },
    {
      "t": "interaction",
      "note": "via InteractionLedgerReader (E1-068)"
    },
    {
      "t": "document",
      "note": "via the P5 document hub"
    }
  ],
  "stores": "Access log / PII Kafka via AccessEventPublisher (AC-READ). No data copied.",
  "functions": [
    {
      "name": "CaseRecordQueryService",
      "does": "compose sections + merged history"
    },
    {
      "name": "AceSourceReader",
      "does": "SELECT on 4 views by key"
    },
    {
      "name": "MaskingApplier",
      "does": "FieldMasker + AC-READ event"
    },
    {
      "name": "CaseAndWorkflowController",
      "does": "5 P3 read endpoints"
    },
    {
      "name": "CaseRecordPage",
      "does": "React SCR-03 with date badges"
    },
    {
      "name": "StaleBanner, OnHoldBanner",
      "does": "MSG-P1-001, MSG-P3-004"
    }
  ],
  "path": [
    {
      "kind": "trigger",
      "text": "Open case RW-2026-000701"
    },
    {
      "kind": "check",
      "text": "Case record R + in scope?"
    },
    {
      "kind": "table",
      "text": "recovery_case + key links"
    },
    {
      "kind": "ace",
      "text": "v_ace_account / customer / contact"
    },
    {
      "kind": "function",
      "text": "Mask by role + AC-READ log"
    },
    {
      "kind": "out",
      "text": "SCR-03 with ACE date per section"
    }
  ],
  "rules": [
    "BR1: every section shows its ACE business date",
    "BR3: the ID number is never shown in clear (id_no_masked / id_no_last4 only)",
    "BR4: a read that cannot be logged returns nothing",
    "BR8: live reads from 4 views; no copy is kept"
  ],
  "risks": [
    "ACE batch not COMPLETE -> stale banner (MSG-P1-001)",
    "Case out of scope -> 404 (MSG-P4-003)",
    "Access event fails -> read refused (MSG-P7-003)"
  ],
  "example": [
    "Case RW-2026-000701: owner U-81, HP, 2 accounts",
    "Account A-7001: 97 days past due, THB 206,175.00, ACE date 2026-12-02 (data_as_of)",
    "p95 under 2 s with 50 documents and 120 history entries"
  ]
}
