{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "mcp": {
    "servers": {
      "jira": {
        "type": "local",
        "command": ["node", "-e", "process.exit(0)"],
        "enabled": false
      }
    }
  },
  "policies": [
    { "action": "mcp.use", "resource": "jira", "effect": "deny" }
  ],
  "permission": { "webfetch": "deny", "edit": "allow", "bash": "allow" }
}
