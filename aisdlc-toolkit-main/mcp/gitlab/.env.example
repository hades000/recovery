# GitLab connection. Copy to .env (same folder) and fill in, OR pass these via your MCP client config.
# Base URL of your on-prem GitLab (include any relative URL root, e.g. https://git.company.com/gitlab)
GITLAB_URL=https://gitlab.your-company.com

# Personal Access Token: GitLab > Preferences > Access Tokens.
# Scope "api" for read + write, or "read_api" for read-only.
GITLAB_TOKEN=
