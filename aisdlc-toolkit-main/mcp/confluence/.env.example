# Confluence connection. Copy to .env (same folder) and fill in, OR pass these via your MCP client config.
# Cloud: include /wiki. Server/DC: base URL including any context path.
CONFLUENCE_URL=https://your-company.atlassian.net/wiki

# Confluence Cloud: Atlassian account email + API token (https://id.atlassian.com/manage-profile/security/api-tokens)
CONFLUENCE_EMAIL=you@your-company.com
CONFLUENCE_API_TOKEN=

# Confluence Server / Data Center: Personal Access Token (Profile > Settings > Personal Access Tokens). Leave CONFLUENCE_EMAIL empty.
# CONFLUENCE_PAT=
