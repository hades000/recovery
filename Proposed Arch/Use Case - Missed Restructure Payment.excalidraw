    {"type":"text","id":"pp2","x":1100,"y":575,"width":220,"height":32.5,"text":"Customer can pay any day;\nthe wait then ends early","originalText":"Customer can pay any day;\nthe wait then ends early","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":200021,"lineHeight":1.25,"containerId":null},
    {"type":"arrow","id":"pay","x":1180,"y":570,"width":0,"height":84,"points":[[0,0],[0,-84]],"strokeColor":"#047857","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":200022,"startArrowhead":null,"endArrowhead":"arrow"},
    {"type":"text","id":"pp3","x":1584,"y":580,"width":236,"height":32.5,"text":"Case owner task,\ndue in 5 working days","originalText":"Case owner task,\ndue in 5 working days","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":200023,"lineHeight":1.25,"containerId":null},

    {"type":"rectangle","id":"proof","x":255,"y":668,"width":1565,"height":46,"strokeColor":"#047857","backgroundColor":"#a7f3d0","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":200030,"roundness":{"type":3},"boundElements":[{"id":"proof_t","type":"text"}]},
    {"type":"text","id":"proof_t","x":259,"y":681.6,"width":1557,"height":18.75,"text":"Every rule answer above is saved with its rule ID and version, so audit can always see why the case moved","originalText":"Every rule answer above is saved with its rule ID and version, so audit can always see why the case moved","fontSize":15,"fontFamily":3,"textAlign":"center","verticalAlign":"middle","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":200031,"lineHeight":1.25,"containerId":"proof"},

    {"type":"line","id":"div_bot","x":40,"y":745,"width":1780,"height":0,"points":[[0,0],[1780,0]],"strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"seed":200040},
    {"type":"diamond","id":"tk1i","x":40,"y":770,"width":30,"height":26,"strokeColor":"#b45309","backgroundColor":"#fef3c7","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":200041},
    {"type":"text","id":"tk1","x":82,"y":770,"width":520,"height":37.5,"text":"Drools is the rulebook. 30 days and the 2-break\nlimit are business settings, changed without IT.","originalText":"Drools is the rulebook. 30 days and the 2-break\nlimit are business settings, changed without IT.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":200042,"lineHeight":1.25,"containerId":null},
    {"type":"rectangle","id":"tk2i","x":640,"y":773,"width":30,"height":20,"strokeColor":"#1e3a5f","backgroundColor":"#3b82f6","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":200043,"roundness":{"type":3}},
    {"type":"text","id":"tk2","x":682,"y":770,"width":520,"height":37.5,"text":"Temporal is the clock. A 30-day wait is never\nforgotten, even if a server restarts.","originalText":"Temporal is the clock. A 30-day wait is never\nforgotten, even if a server restarts.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":200044,"lineHeight":1.25,"containerId":null},
    {"type":"rectangle","id":"tk3i","x":1240,"y":773,"width":30,"height":20,"strokeColor":"#047857","backgroundColor":"#a7f3d0","fillStyle":"solid","strokeWidth":2,"roughness":0,"opacity":100,"seed":200045,"roundness":{"type":3}},
    {"type":"text","id":"tk3","x":1282,"y":770,"width":540,"height":37.5,"text":"The decision log is the proof. Each step names\nthe rule and the version that made it.","originalText":"The decision log is the proof. Each step names\nthe rule and the version that made it.","fontSize":15,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"roughness":0,"opacity":100,"seed":200046,"lineHeight":1.25,"containerId":null}
  ],
