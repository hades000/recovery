{
  "interactiveLogin": true,
  "httpServer": "NettyWrapper",
  "tokenCallbacks": [
    {
      "issuerId": "entra",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "client_id",
          "match": "rwb-local-coe",
          "claims": {
            "sub": "00000000-0000-0000-0000-00000000c0e1",
            "preferred_username": "coe.author@local.test",
            "name": "Local RW-COE author",
            "aud": ["api://rwb-recovery"],
            "roles": ["RW-COE"]
          }
        },
        {
          "requestParam": "client_id",
          "match": "rwb-local-risk",
          "claims": {
            "sub": "00000000-0000-0000-0000-00000000815c",
            "preferred_username": "risk.approver@local.test",
            "name": "Local RW-RISK approver",
            "aud": ["api://rwb-recovery"],
            "roles": ["RW-RISK"]
          }
        },
        {
          "requestParam": "client_id",
          "match": "rwb-local-platadm",
          "claims": {
            "sub": "00000000-0000-0000-0000-0000000a0d01",
            "preferred_username": "platform.admin@local.test",
            "name": "Local RW-PLATADM operator",
            "aud": ["api://rwb-recovery"],
            "roles": ["RW-PLATADM"]
          }
        },
        {
          "requestParam": "client_id",
          "match": "rwb-local-audit",
          "claims": {
            "sub": "00000000-0000-0000-0000-0000000a0d17",
            "preferred_username": "auditor@local.test",
            "name": "Local RW-AUDIT reader",
            "aud": ["api://rwb-recovery"],
            "roles": ["RW-AUDIT"]
          }
        },
        {
          "requestParam": "client_id",
          "match": "rwb-local-norole",
          "claims": {
            "sub": "00000000-0000-0000-0000-000000000000",
            "preferred_username": "no.role@local.test",
            "name": "Local user with no Workbench role",
            "aud": ["api://rwb-recovery"],
            "roles": []
          }
        },
        {
          "requestParam": "client_id",
          "match": "*",
          "claims": {
            "aud": ["api://rwb-recovery"]
          }
        }
      ]
    }
  ]
}
